---
import { site } from '../data/site';
---

<section class="section contact" id="contact">
  <div class="shell contact__inner">
    <div>
      <span class="label">06 / Contact</span>
      <h2 class="contact__title">
        Open to work on gameplay systems, netcode, tooling and engines.
      </h2>
      <p class="contact__body">
        If any of the above lines up with what you are building, the fastest way to reach me is
        email.
      </p>
    </div>
    <div class="contact__links">
      <a class="contact__mail" href={`mailto:${site.email}`}>
        {site.email} <span class="arrow">→</span>
      </a>
      <div class="contact__row">
        <a href={site.links.github}>GitHub</a>
        <a href={site.links.linkedin}>LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  .contact__title {
    margin-top: 1.25rem;
    max-width: 20ch;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
  }

  .contact__body {
    margin-top: 1.25rem;
    max-width: 42ch;
    color: var(--muted);
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .contact__mail {
    font-family: var(--mono);
    font-size: clamp(0.9375rem, 1.9vw, 1.25rem);
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.4rem;
    word-break: break-all;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }

  .contact__mail:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact__row {
    display: flex;
    gap: 1.25rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .contact__row a {
    border-bottom: 1px solid transparent;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .contact__row a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  @media (max-width: 62rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
