---
import { work } from '../data/work';
---

<section class="section" id="work">
  <div class="shell">
    <div class="section__head">
      <span class="section__index">01</span>
      <h2 class="section__title">Selected work</h2>
      <p class="section__aside">
        Four projects that show the range — an engine, a game I shipped solo, a team title I was
        hired onto, and a library.
      </p>
    </div>

    <ul class="rows">
      {
        work.map((w, i) => (
          <li class="row">
            <a class="row__link" href={`/work/${w.slug}`}>
              <span class="row__num">{String(i + 1).padStart(2, '0')}</span>

              <span class="row__thumb">
                {w.cover && (
                  <img
                    src={w.cover.src}
                    alt={w.cover.alt}
                    width={w.cover.w}
                    height={w.cover.h}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>

              <span class="row__body">
                <span class="row__top">
                  <h3 class="row__title">{w.title}</h3>
                  <span class="row__kind">{w.kind}</span>
                </span>

                <span class="row__blurb">{w.blurb}</span>

                <span class="tag-row row__tags">
                  {w.stack.slice(0, 5).map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </span>

                <span class="row__foot">
                  <span class="row__role">
                    {w.role} <span class="row__scope">· {w.scope}</span>
                  </span>
                  <span class="row__cta">
                    Case study <span class="arrow">→</span>
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rows {
    border-top: 1px solid var(--line-strong);
  }

  .row {
    border-bottom: 1px solid var(--line-strong);
  }

  .row__link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 21rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.25rem) 1rem;
    transition: background 0.2s var(--ease);
  }

  .row__link:hover {
    background: var(--paper-deep);
  }

  .row__num {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    padding-top: 0.4rem;
  }

  .row__thumb {
    display: block;
    align-self: start;
    min-width: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--paper-deep);
  }

  .row__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
    transition: transform 0.35s var(--ease), filter 0.35s var(--ease);
  }

  .row__link:hover .row__thumb img {
    transform: scale(1.03);
    filter: saturate(1);
  }

  .row__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .row__top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .row__title {
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
  }

  .row__kind {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .row__blurb {
    display: block;
    max-width: 52ch;
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }

  .row__tags {
    margin-top: 1.1rem;
  }

  .row__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: var(--rule);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .row__role {
    color: var(--ink);
  }

  .row__scope {
    color: var(--muted);
  }

  .row__cta {
    color: var(--accent);
    white-space: nowrap;
  }

  @media (max-width: 62rem) {
    .row__link {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      row-gap: 1.25rem;
      padding-inline: 0;
    }

    .row__thumb {
      grid-column: 2;
      max-width: 24rem;
    }

    .row__body {
      grid-column: 2;
    }
  }

  @media (max-width: 38rem) {
    .row__link {
      grid-template-columns: minmax(0, 1fr);
    }

    .row__num {
      padding-top: 0;
    }

    .row__thumb,
    .row__body {
      grid-column: 1;
    }
  }
</style>
