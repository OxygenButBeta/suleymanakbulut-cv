---
import { work } from '../data/work';
---

<section class="section" id="work">
  <div class="shell">
    <div class="section__head">
      <span class="section__index">01</span>
      <h2 class="section__title">Selected work</h2>
      <p class="section__aside">
        Four projects that show the range — an engine, two shipped commercial titles and a library.
      </p>
    </div>

    <ul class="rows">
      {
        work.map((w, i) => (
          <li class="row">
            <a class="row__link" href={`/work/${w.slug}`}>
              <span class="row__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="row__body">
                <span class="row__top">
                  <h3 class="row__title">{w.title}</h3>
                  <span class="row__kind">{w.kind}</span>
                </span>
                <span class="row__blurb">{w.blurb}</span>
                <span class="tag-row row__tags">
                  {w.stack.slice(0, 5).map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </span>
              </span>
              <span class="row__meta">
                <span class="row__role">{w.role}</span>
                <span class="row__cta">
                  Case study <span class="arrow">→</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rows {
    border-top: 1px solid var(--line-strong);
  }

  .row {
    border-bottom: 1px solid var(--line-strong);
  }

  .row__link {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 13rem;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 1rem;
    transition: background 0.2s var(--ease), padding-inline 0.2s var(--ease);
  }

  .row__link:hover {
    background: var(--paper-deep);
    padding-inline: 1.5rem 0.5rem;
  }

  .row__num {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
    padding-top: 0.55rem;
  }

  .row__body {
    display: block;
  }

  .row__top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .row__title {
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
  }

  .row__kind {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .row__blurb {
    display: block;
    max-width: 52ch;
    margin-top: 0.6rem;
    color: var(--ink-soft);
  }

  .row__tags {
    margin-top: 1rem;
  }

  .row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-align: right;
  }

  .row__role {
    color: var(--muted);
  }

  .row__cta {
    color: var(--accent);
    white-space: nowrap;
  }

  @media (max-width: 62rem) {
    .row__link,
    .row__link:hover {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      padding-inline: 0;
    }

    .row__meta {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
      margin-top: 1.25rem;
      width: 100%;
    }
  }
</style>
