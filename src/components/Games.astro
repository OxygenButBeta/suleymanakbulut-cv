---
import { games } from '../data/games';
---

<section class="section" id="games">
  <div class="shell">
    <div class="section__head">
      <span class="section__index">05</span>
      <h2 class="section__title">Games</h2>
      <p class="section__aside">
        Shipped titles and the mobile work before them. Every entry states what was mine.
      </p>
    </div>

    <ul class="games">
      {
        games.map((g) => (
          <li class={`game${g.featured ? ' game--featured' : ''}`}>
            <a class="game__link" href={g.href}>
              {g.cover && (
                <span class="game__cover">
                  <img
                    src={g.cover}
                    alt={`${g.title} store artwork`}
                    width="460"
                    height="215"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
              <span class="game__inner">
                <span class="game__head">
                  <h3 class="game__title">{g.title}</h3>
                  <span class="game__platform">{g.platform}</span>
                </span>
                <span class="game__role">
                  {g.role} <span class="game__scope">· {g.scope}</span>
                </span>
                <span class="game__body">{g.description}</span>
                <span class="tag-row game__tags">
                  {g.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
              </span>
            </a>
          </li>
        ))
      }
      <li class="game game--filler" aria-hidden="true"></li>
      <li class="game game--filler" aria-hidden="true"></li>
      <li class="game game--filler" aria-hidden="true"></li>
    </ul>
  </div>
</section>

<style>
  .games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: var(--rule);
  }

  .game {
    background: var(--paper);
  }

  .game--featured {
    background: var(--paper-raised);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .game__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: background 0.18s var(--ease);
  }

  .game__link:hover {
    background: var(--paper-deep);
  }

  .game__cover {
    display: block;
    aspect-ratio: 460 / 215;
    overflow: hidden;
    border-bottom: var(--rule);
  }

  .game__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
    transition: transform 0.35s var(--ease), filter 0.35s var(--ease);
  }

  .game__link:hover .game__cover img {
    transform: scale(1.03);
    filter: saturate(1);
  }

  .game__inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  .game__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .game__title {
    font-size: 1.0625rem;
  }


  .game__platform {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .game__role {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
  }

  .game__scope {
    color: var(--muted);
  }

  .game__body {
    display: block;
    margin-top: 0.85rem;
    font-size: 0.9375rem;
    color: var(--muted);
    flex: 1;
  }

  .game__tags {
    margin-top: 1.25rem;
  }

</style>
