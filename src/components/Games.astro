---
import { games } from '../data/games';

const groups = [
  {
    title: 'My own titles',
    note: 'Mine end to end, published under Heavyworks Games — my own one-person studio.',
    items: games.filter((g) => g.group === 'own'),
  },
  {
    title: 'Titles I worked on for other teams',
    note: 'Not my games and not my IP — I was brought in as a developer, on staff or on contract. Each entry covers only the part I built.',
    items: games.filter((g) => g.group === 'contributed'),
  },
  {
    title: 'Earlier mobile work',
    note: 'Where I started — smaller mobile projects from before the PC titles.',
    items: games.filter((g) => g.group === 'earlier'),
  },
];
---

<section class="section" id="games">
  <div class="shell">
    <div class="section__head">
      <span class="section__index">05</span>
      <h2 class="section__title">Game credits</h2>
      <p class="section__aside">
        Shipped titles and the mobile work before them, split by whose game it actually is.
      </p>
    </div>

    {
      groups.map((group) => (
        <div class="group">
          <div class="group__head">
            <h3 class="group__title">{group.title}</h3>
            <p class="group__note">{group.note}</p>
          </div>

          <ul class="games">
            {group.items.map((g) => (
              <li class={`game${g.featured ? ' game--featured' : ''}`}>
                <a class="game__link" href={g.href}>
                  {g.cover && (
                    <span class="game__cover">
                      <img
                        src={g.cover}
                        alt={`${g.title} store artwork`}
                        width="460"
                        height="215"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  )}
                  <span class="game__inner">
                    <span class="game__head">
                      <h4 class="game__title">{g.title}</h4>
                      <span class="game__platform">{g.platform}</span>
                    </span>
                    {g.studio && <span class="game__studio">{g.studio}</span>}
                    <span class="game__role">
                      {g.role} <span class="game__scope">· {g.scope}</span>
                    </span>
                    <span class="game__body">{g.description}</span>
                    <span class="tag-row game__tags">
                      {g.tags.map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <p class="upcoming">
      More titles are in production — under Heavyworks Games and at Londer Software — none announced
      yet.
    </p>
  </div>
</section>

<style>
  .group + .group {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .group__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .group__title {
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .group__note {
    max-width: 48ch;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1px;
  }

  .game {
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
  }

  .game--featured {
    background: var(--paper-raised);
    box-shadow: 0 0 0 1px var(--line), inset 2px 0 0 var(--accent);
  }

  .game__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: background 0.18s var(--ease);
  }

  .game__link:hover {
    background: var(--paper-deep);
  }

  .game__cover {
    display: block;
    aspect-ratio: 460 / 215;
    overflow: hidden;
    border-bottom: var(--rule);
  }

  .game__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
    transition: transform 0.35s var(--ease), filter 0.35s var(--ease);
  }

  .game__link:hover .game__cover img {
    transform: scale(1.03);
    filter: saturate(1);
  }

  .game__inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  .game__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .game__title {
    font-size: 1.0625rem;
  }

  .game__platform {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .upcoming {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 1rem;
    border-top: var(--rule);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .game__studio {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .game__role {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent);
  }

  .game__studio + .game__role {
    margin-top: 0.35rem;
  }

  .game__scope {
    color: var(--muted);
  }

  .game__body {
    display: block;
    margin-top: 0.85rem;
    font-size: 0.9375rem;
    color: var(--muted);
    flex: 1;
  }

  .game__tags {
    margin-top: 1.25rem;
  }
</style>
