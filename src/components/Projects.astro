---
import ProjectGrid from './ProjectGrid.astro';
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.featured);
const rest = projects.length - featured.length;
---

<section class="section" id="projects">
  <div class="shell">
    <div class="section__head">
      <span class="section__index">04</span>
      <h2 class="section__title">Selected open source</h2>
      <p class="section__aside">
        Mostly things I needed and could not find — released as open source.
      </p>
    </div>

    <ProjectGrid items={featured} />

    <a class="all" href="/projects">
      View all open-source projects <span class="all__count">({rest} more)</span>
      <span class="arrow">→</span>
    </a>
  </div>
</section>

<style>
  .all {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--accent);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.2rem;
  }

  .all:hover {
    border-color: var(--accent);
  }

  .all__count {
    color: var(--muted);
  }
</style>
