---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist.">
  <section class="shell nf">
    <span class="label">Error 404</span>
    <h1 class="nf__title">This page does not exist.</h1>
    <a class="btn" href="/">Back to home <span class="arrow">→</span></a>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: clamp(5rem, 15vw, 10rem);
  }

  .nf__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
  }
</style>
