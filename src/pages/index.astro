---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Focus from '../components/Focus.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Games from '../components/Games.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: [site.links.github, site.links.linkedin],
  knowsAbout: ['C#', '.NET', 'Unity', 'Game Development', 'Multiplayer Networking', 'DirectX 12'],
};
---

<Base>
  <Hero />
  <SelectedWork />
  <Focus />
  <Experience />
  <Projects />
  <Games />
  <Contact />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>
